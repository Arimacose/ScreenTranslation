<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/online_settings_title"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/online_settings_explanation"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/edit_online_base_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/online_base_url_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="2" />

        <EditText
            android:id="@+id/edit_online_model_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/online_model_id_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="2" />

        <EditText
            android:id="@+id/edit_online_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="password"
            android:hint="@string/online_api_key_hint"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLines="1" />

        <TextView
            android:id="@+id/text_online_key_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?android:attr/textColorSecondary" />

        <CheckBox
            android:id="@+id/check_online_consent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/online_data_flow_consent" />

        <Button
            android:id="@+id/button_online_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/online_save"
            android:textAllCaps="false" />

        <EditText
            android:id="@+id/edit_online_test_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="top|start"
            android:hint="@string/online_test_text_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/button_online_save_test"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/online_save_and_test"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/button_online_delete_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/online_delete_key"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/text_online_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/online_not_tested"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
