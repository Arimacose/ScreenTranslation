<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/model_management_title"
            android:textAppearance="@style/TextAppearance.ScreenTranslation.Apple.LargeTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/model_management_subtitle"
            android:textAppearance="@style/TextAppearance.ScreenTranslation.Apple.Footnote" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ScreenTranslation.Apple.Group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <TextView
                android:id="@+id/text_model_inventory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:padding="16dp"
                android:text="@string/model_inventory_loading"
                android:textAppearance="@style/TextAppearance.ScreenTranslation.Apple.Body"
                android:textIsSelectable="true" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_prepare_models"
            style="@style/Widget.ScreenTranslation.Apple.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/model_prepare_current_download" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_refresh_models"
            style="@style/Widget.ScreenTranslation.Apple.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/model_refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_delete_models"
            style="@style/Widget.ScreenTranslation.Apple.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/model_delete_downloads" />
    </LinearLayout>
</ScrollView>
