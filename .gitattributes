* text=auto

# Source and documentation use LF on every platform.
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
keystore.properties.example text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hpp text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf
*.txt text eol=lf

# Keep third-party license snapshots byte-for-byte identical to their upstream
# sources. Some canonical notices intentionally contain trailing spaces or
# CRLF, so generic whitespace and line-ending normalization must not rewrite
# the files covered by SHA256SUMS.
third_party/licenses/** -text -whitespace
third_party/licenses/SHA256SUMS text eol=lf
gradlew text eol=lf

# Windows launchers retain native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts must never be line-ending normalized.
*.jar binary
*.png binary
*.webp binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.apk binary
*.aab binary
*.apks binary
*.idsig binary
*.jks binary
*.keystore binary
