<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.ScreenTranslation.PageTitle" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.ScreenTranslation.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.ScreenTranslation.Supporting" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.ScreenTranslation.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">?attr/screenCardCornerRadius</item>
        <item name="cardElevation">?attr/screenCardElevation</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">?attr/screenCardStrokeWidth</item>
    </style>

    <style name="Widget.ScreenTranslation.HeroCard" parent="Widget.ScreenTranslation.Card">
        <item name="cardBackgroundColor">?attr/screenHeroColor</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.ScreenTranslation.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">?attr/screenControlMinHeight</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">?attr/screenControlCornerRadius</item>
    </style>

    <style name="Widget.ScreenTranslation.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">?attr/screenControlMinHeight</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">?attr/screenControlCornerRadius</item>
    </style>

    <style name="Widget.ScreenTranslation.Button.Danger" parent="Widget.ScreenTranslation.Button.Outlined">
        <item name="android:textColor">?attr/colorError</item>
        <item name="strokeColor">?attr/colorError</item>
    </style>

    <style name="Widget.ScreenTranslation.ExperimentalBanner" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:background">@drawable/bg_experimental_banner</item>
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Apple is intentionally a separate component language rather than a
         recoloured Material/MIUIX skin. The dedicated Apple layouts use these
         tokens to reproduce iOS grouped settings, large titles and segmented
         controls while retaining Android accessibility and input behaviour. -->
    <style name="TextAppearance.ScreenTranslation.Apple.LargeTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/apple_on_surface</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TextAppearance.ScreenTranslation.Apple.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/apple_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.ScreenTranslation.Apple.RowTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/apple_on_surface</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.ScreenTranslation.Apple.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/apple_on_surface</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.ScreenTranslation.Apple.Footnote" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/apple_on_surface_variant</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.ScreenTranslation.Apple.Group" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/apple_surface</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.ScreenTranslation.Apple.Hero" parent="Widget.ScreenTranslation.Apple.Group">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">0dp</item>
    </style>

    <style name="Widget.ScreenTranslation.Apple.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="backgroundTint">@color/apple_primary</item>
        <item name="android:textColor">@color/apple_on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.ScreenTranslation.Apple.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="backgroundTint">@color/apple_surface_variant</item>
        <item name="android:textColor">@color/apple_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.ScreenTranslation.Apple.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/apple_error</item>
        <item name="backgroundTint">@color/apple_surface</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.ScreenTranslation.Apple.SegmentedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="backgroundTint">@color/apple_segmented_button_background</item>
        <item name="android:textColor">@color/apple_segmented_button_text</item>
        <item name="strokeWidth">0dp</item>
        <item name="cornerRadius">8dp</item>
        <item name="elevation">0dp</item>
    </style>

</resources>
